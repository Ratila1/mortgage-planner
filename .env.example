POSTGRES_DB=mortgage
POSTGRES_USER=mortgage
POSTGRES_PASSWORD=mortgage
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
JWT_SECRET=change-me-change-me-change-me-change-me
# --- Публичный адрес приложения (ссылки в письмах и OAuth) ---
# локально: http://localhost:8080, через туннель: https://<что-то>.trycloudflare.com
APP_BASE_URL=http://localhost:8080

# --- OAuth2 (необязательно). Включается: SPRING_PROFILES_ACTIVE=oauth ---
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
#   Authorized redirect URI: ${APP_BASE_URL}/login/oauth2/code/google
# GitHub: Settings -> Developer settings -> OAuth Apps
#   Authorization callback URL: ${APP_BASE_URL}/login/oauth2/code/github
SPRING_PROFILES_ACTIVE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
