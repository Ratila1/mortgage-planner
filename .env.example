POSTGRES_DB=nosurprise
POSTGRES_USER=nosurprise
POSTGRES_PASSWORD=nosurprise

# --- Инфраструктура: пароли только для локальной разработки ---
# Порты Mongo/Redis/RabbitMQ слушают 127.0.0.1, наружу не торчат.
# Для прод-окружения заменить на сильные значения.
MONGO_USER=nosurprise
MONGO_PASSWORD=nosurprise
REDIS_PASSWORD=nosurprise
RABBITMQ_USER=nosurprise
RABBITMQ_PASSWORD=nosurprise

# --- JWT_SECRET строго обязателен (§7): без него compose не поднимется ---
# Сгенерировать: openssl rand -base64 48  или  [Convert]::ToBase64String((1..48 | %{Get-Random -Max 256}))
JWT_SECRET=

# --- Метрики (опционально). Пусто = /actuator/prometheus и /actuator/metrics закрыты ---
# Те же креды Prometheus подставляет в свой конфиг при старте (basic_auth в scrape_configs).
# В compose пустое значение заменяется на prometheus/prometheus — только для локальной разработки.
METRICS_USER=
METRICS_PASSWORD=

# --- Публичный адрес приложения (ссылки в письмах и OAuth) ---
# локально: http://localhost:8080, через туннель: https://<что-то>.trycloudflare.com
APP_BASE_URL=http://localhost:8080

# --- OAuth2 (необязательно). Включается: SPRING_PROFILES_ACTIVE=oauth ---
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
#   Authorized redirect URI: ${APP_BASE_URL}/login/oauth2/code/google
# GitHub: Settings -> Developer settings -> OAuth Apps
#   Authorization callback URL: ${APP_BASE_URL}/login/oauth2/code/github
SPRING_PROFILES_ACTIVE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- SMS (подтверждение телефона и подпись договора) ---
# Реальные SMS отправляет отдельный sms-verification-service; backend только вызывает его по HTTP.
# Провайдер sms-verification-service: sim | vonage | twilio (см. блок ниже).

# SMS Verification Service client config (used by backend to call sms-verification-service)
SMS_CLIENT_BASE_URL=http://sms-verification-service:8091
# Секрет для подписи service-to-service JWT; должен совпадать с JWT_SECRET в sms-verification-service.
# Можно не задавать — тогда берётся JWT_SECRET.
SMS_CLIENT_SERVICE_JWT_SECRET=

# SMS Verification Service provider (sim | vonage | twilio)
SMS_VERIFY_PROVIDER=sim

# Vonage: dashboard.nexmo.com -> API key и API secret. На пробном аккаунте SMS уходят только на тестовые номера.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=Vonage APIs

# Twilio
TWILIO_ACCOUNT_SID=
# Можно вместо Auth Token использовать API-ключ: TWILIO_API_KEY_SID=SK..., TWILIO_AUTH_SECRET=<секрет ключа>
TWILIO_API_KEY_SID=
TWILIO_AUTH_SECRET=
TWILIO_FROM=
# Либо Messaging Service вместо номера: MG...
TWILIO_MESSAGING_SERVICE_SID=

# --- Telegram 2FA (вынесен из notification-service в sms-verification-service) ---
# Бот создаётся у @BotFather; токен и service-token — секреты, в репозиторий не коммитятся.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Локально бот сам забирает апдейты через getUpdates; в проде выключить и поставить webhook.
TELEGRAM_POLLING_ENABLED=true
# Секрет для X-Telegram-Bot-Api-Secret-Token: тот же 값 передаётся в setWebhook(secret_token).
# Без него /telegram/webhook отклоняет все запросы (безопасно при polling).
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Обязательный общий секрет для X-Service-Token между backend и sms-verification-service.
# Compose не поднимется, если значение пустое; дефолта намеренно нет.
SERVICE_TOKEN=

# --- Первый ADMIN (FirstAdminBootstrap) ---
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=admin12345

# --- Grafana (порт 3000) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin