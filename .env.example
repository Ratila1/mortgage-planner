POSTGRES_DB=nosurprise
POSTGRES_USER=nosurprise
POSTGRES_PASSWORD=nosurprise

# --- Инфраструктура: пароли только для локальной разработки ---
# Порты Mongo/Redis/RabbitMQ слушают 127.0.0.1, наружу не торчат.
# Для прод-окружения заменить на сильные значения.
MONGO_USER=nosurprise
MONGO_PASSWORD=nosurprise
REDIS_PASSWORD=nosurprise
RABBITMQ_USER=nosurprise
RABBITMQ_PASSWORD=nosurprise

# --- JWT_SECRET строго обязателен (§7): без него compose не поднимется ---
# Сгенерировать: openssl rand -base64 48  или  [Convert]::ToBase64String((1..48 | %{Get-Random -Max 256}))
JWT_SECRET=

# --- Метрики (опционально). Пусто = /actuator/prometheus и /actuator/metrics закрыты ---
# Задать, если Prometheus-скрейпер должен ходить с basic-авторизацией.
METRICS_USER=
METRICS_PASSWORD=

# --- Публичный адрес приложения (ссылки в письмах и OAuth) ---
# локально: http://localhost:8080, через туннель: https://<что-то>.trycloudflare.com
APP_BASE_URL=http://localhost:8080

# --- Профили: oauth — вход через Google/GitHub (ниже); seed — тестовые данные (50 клиентов, ~750 заявок,
# пароль Seed12345, см. backend/src/main/resources/db/seed). Несколько — через запятую: oauth,seed ---
# --- OAuth2 (необязательно). Включается: SPRING_PROFILES_ACTIVE=oauth ---
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
#   Authorized redirect URI: ${APP_BASE_URL}/login/oauth2/code/google
# GitHub: Settings -> Developer settings -> OAuth Apps
#   Authorization callback URL: ${APP_BASE_URL}/login/oauth2/code/github
SPRING_PROFILES_ACTIVE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- SMS (подтверждение телефона и подпись договора) ---
# log — код пишется в лог бэкенда (docker compose logs backend); vonage или twilio — реальные SMS.
# Twilio: console.twilio.com -> Account SID и Auth Token; номер с поддержкой SMS -> TWILIO_FROM.
# На trial-аккаунте SMS уходят только на номера из Verified Caller IDs.
SMS_PROVIDER=log

# Vonage: dashboard.nexmo.com -> API key и API secret. На пробном аккаунте SMS уходят только на тестовые номера.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=Vonage APIs

# Twilio
TWILIO_ACCOUNT_SID=
# Можно вместо Auth Token использовать API-ключ: TWILIO_API_KEY_SID=SK..., TWILIO_AUTH_SECRET=<секрет ключа>
TWILIO_API_KEY_SID=
TWILIO_AUTH_SECRET=
TWILIO_FROM=
# Либо Messaging Service вместо номера: MG...
TWILIO_MESSAGING_SERVICE_SID=

# --- Первый ADMIN (FirstAdminBootstrap) ---
APP_ADMIN_EMAIL=admin@nosurprise.local
APP_ADMIN_PASSWORD=admin12345

# --- Метрики / observability ---
METRICS_USER=prometheus
METRICS_PASSWORD=prometheus
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Кредитное бюро (CREDIT_BUREAU.md) ---
# Ключ админского API бюро (заголовок X-Admin-Key): заводить банки и выдавать им ключи. Пусто — админский API закрыт.
#   openssl rand -base64 32
BUREAU_ADMIN_KEY=
# Ключ песочницы (создаётся при первом старте, если провайдеров ещё нет). Формат nsb_<8 символов a-z0-9>_<43 символа>:
#   echo "nsb_sandbox1_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
BUREAU_SANDBOX_KEY=
# Пользователь, под которым бюро читает VIEW монолита. Пусто — тот же POSTGRES_USER (локально).
# В проде — отдельная роль с SELECT только на bureau_applicant_lookup (CREDIT_BUREAU.md §5.2).
LOOKUP_DB_USER=lookup
LOOKUP_DB_PASSWORD=lookup
