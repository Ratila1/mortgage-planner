POSTGRES_DB=nosurprise
POSTGRES_USER=nosurprise
POSTGRES_PASSWORD=nosurprise

# --- Инфраструктура: пароли только для локальной разработки ---
# Порты Mongo/Redis/RabbitMQ слушают 127.0.0.1, наружу не торчат.
# Для прод-окружения заменить на сильные значения.
MONGO_USER=nosurprise
MONGO_PASSWORD=nosurprise
REDIS_PASSWORD=nosurprise
RABBITMQ_USER=nosurprise
RABBITMQ_PASSWORD=nosurprise

# --- JWT_SECRET строго обязателен (§7): без него compose не поднимется ---
# Сгенерировать: openssl rand -base64 48  или  [Convert]::ToBase64String((1..48 | %{Get-Random -Max 256}))
JWT_SECRET=

# --- Метрики (опционально). Пусто = /actuator/prometheus и /actuator/metrics закрыты ---
# Задать, если Prometheus-скрейпер должен ходить с basic-авторизацией.
METRICS_USER=
METRICS_PASSWORD=

# --- Публичный адрес приложения (ссылки в письмах и OAuth) ---
# локально: http://localhost:8080, через туннель: https://<что-то>.trycloudflare.com
APP_BASE_URL=http://localhost:8080

# --- OAuth2 (необязательно). Включается: SPRING_PROFILES_ACTIVE=oauth ---
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
#   Authorized redirect URI: ${APP_BASE_URL}/login/oauth2/code/google
# GitHub: Settings -> Developer settings -> OAuth Apps
#   Authorization callback URL: ${APP_BASE_URL}/login/oauth2/code/github
SPRING_PROFILES_ACTIVE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
