{
  "info": {
    "name": "Кредитное бюро (credit-bureau)",
    "description": "Запросы к сервису кредитного бюро через nginx (CREDIT_BUREAU.md).\n\nПеред запуском заполните переменные коллекции adminKey (BUREAU_ADMIN_KEY) и sandboxKey (BUREAU_SANDBOX_KEY). apiKey и providerId заполняются сами запросами 01–02.\n\nЗапускать по порядку (Run collection). Неверные ключи (запрос 18 и подобные) увеличивают счётчик неудач по IP: после 10 за 10 минут бюро отвечает 429.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Админ: провайдеры и ключи",
      "item": [
        {
          "name": "01 Создать провайдера",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/providers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "providers"
              ]
            },
            "description": "Лимиты не указаны — берутся по умолчанию: 60/мин, 5000/сутки. Сохраняет providerId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Банк Пример {{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"providerId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Выпустить API-ключ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/providers/{{providerId}}/keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "providers",
                "{{providerId}}",
                "keys"
              ]
            },
            "description": "Полный ключ показывается один раз. Сохраняет apiKey и keyId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const k = pm.response.json();",
                  "pm.collectionVariables.set(\"apiKey\", k.apiKey);",
                  "pm.collectionVariables.set(\"keyId\", k.keyId);",
                  "pm.test(\"ключ в формате nsb_<prefix>_<secret>\", () => pm.expect(k.apiKey).to.match(/^nsb_[a-z0-9]{8}_[A-Za-z0-9_-]{43}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Список провайдеров",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/providers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "providers"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"секрета ключа в ответе нет\", () => pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get(\"apiKey\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Провайдер по id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/providers/{{providerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "providers",
                "{{providerId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"providerVersion\", pm.response.json().version);"
                ]
              }
            }
          ]
        }
      ]
    },
