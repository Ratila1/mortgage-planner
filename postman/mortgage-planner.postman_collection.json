              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = (pm.environment.get(\"email\") || \"\").toLowerCase();",
                  "const messages = (pm.response.json().messages || []);",
                  "const match = messages.find(function (m) {",
                  "    const to = (m.To || []).some(function (t) { return (t.Address || \"\").toLowerCase() === email; });",
                  "    return to && (m.Subject || \"\").toLowerCase().indexOf(\"вход\") !== -1;",
                  "});",
                  "pm.test(\"login link email found for \" + email, function () {",
                  "    pm.expect(match, \"no login link message yet - wait a second and send this request again\").to.be.ok;",
                  "});",
                  "if (match) {",
