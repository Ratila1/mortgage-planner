    {
      "name": "3. Phone verification",
      "description": "SMS is sent by sms-verification-service via the sim provider. The code is NOT logged; read it from the database:\n\ndocker exec nosurprise-postgres-1 psql -U nosurprise -d nosurprise -tAc \"select message from sms.sms_request order by created_at desc limit 1\"\n\nCopy the 6 digits into the otpCode environment variable. The code lives for 5 minutes and is burned after 3 wrong attempts; a repeated request reuses the same SMS request (same idempotency key), so after burning you must delete the rows and the Redis key to get a new code.",
      "item": [
        {
          "name": "Request SMS code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 Accepted\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "// Sim provider succeeds in ~70% of attempts; on 'SMS not yet sent' wait 15-30 s.",
                  "// Read the code from sms.sms_request, then set the otpCode environment variable.",
                  "console.log(\"Now run: docker exec nosurprise-postgres-1 psql -U nosurprise -d nosurprise -tAc \\\"select message from sms.sms_request order by created_at desc limit 1\\\"\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/phone/verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me",
                "phone",
                "verification"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Confirm phone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204 No Content\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "// Wrong code gives 400 OTP_INVALID; the third wrong attempt burns the code."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{otpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/me/phone/verification/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me",
                "phone",
                "verification",
                "confirm"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
