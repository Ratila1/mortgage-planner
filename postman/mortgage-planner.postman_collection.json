{
  "info": {
    "_postman_id": "3f0d5c2a-8c8e-4f4e-9d2a-2f6f0a3b7c11",
    "name": "Mortgage Planner (local)",
    "description": "End-to-end flow against the local docker compose stack.\n\nAll traffic goes through the frontend nginx on http://localhost:8080 (the backend and the SMS service are not published).\n\nRun the folders in order:\n1. Auth (email) - register, read the confirmation link from Mailpit, verify, get an access token.\n2. Profile - the phone number must be saved here before requesting an SMS code.\n3. Phone verification - request a code, read it from sms.sms_request (the sim provider does not log it), confirm.\n\nThe access token is stored by the test scripts and sent as a Bearer token. The refresh cookie is kept by the Postman cookie jar.\n\nRate limits per IP: register 5/min, login 10/min, refresh/logout 30/min, link consume 10/min, link request 5/min. SMS service: 3 requests/min per phone, 30/min per IP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth (email)",
      "description": "Registration, email confirmation, session. Every request in this folder is public, so auth is disabled.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh address on every run: an already registered email is not emailed again (anti-enumeration).",
                  "// Comment the next two lines out to use the email from the environment instead.",
                  "const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);",
                  "pm.environment.set(\"email\", \"pm-\" + suffix + \"@example.com\");",
                  "console.log(\"register email:\", pm.environment.get(\"email\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 Accepted\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "// The email is delivered asynchronously via the outbox; wait a second before reading Mailpit."
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Mailpit: find confirmation email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = (pm.environment.get(\"email\") || \"\").toLowerCase();",
                  "const body = pm.response.json();",
                  "const messages = body.messages || [];",
                  "const match = messages.find(function (m) {",
                  "    const to = (m.To || []).some(function (t) { return (t.Address || \"\").toLowerCase() === email; });",
                  "    const subject = (m.Subject || \"\").toLowerCase();",
                  "    return to && subject.indexOf(\"confirm\") !== -1;",
                  "});",
                  "pm.test(\"confirmation email found for \" + email, function () {",
                  "    pm.expect(match, \"no 'Confirm your email' message yet - wait a second and send this request again\").to.be.ok;",
                  "});",
                  "if (match) {",
                  "    pm.environment.set(\"mailId\", match.ID);",
                  "    console.log(\"mailpit message id:\", match.ID);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mailpitUrl}}/api/v1/search?query=to:{{email}}&limit=20",
              "host": [
                "{{mailpitUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "to:{{email}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Mailpit: read email token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const text = body.Text || \"\";",
                  "const match = text.match(/token=([A-Za-z0-9_\\-]+)/);",
                  "pm.test(\"verification token found in email body\", function () {",
                  "    pm.expect(match, \"email body does not contain ?token=...\").to.be.ok;",
                  "});",
                  "if (match) {",
                  "    pm.environment.set(\"emailToken\", match[1]);",
                  "    console.log(\"email token:\", match[1]);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mailpitUrl}}/api/v1/message/{{mailId}}",
              "host": [
                "{{mailpitUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "message",
                "{{mailId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Verify email (login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"access token returned\", function () {",
                  "    pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.environment.set(\"accessToken\", body.accessToken);",
                  "// The refresh_token cookie (Path=/api/auth) is stored by the Postman cookie jar."
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{emailToken}}\"\n}",
              "options": {
