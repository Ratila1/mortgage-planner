    {
      "name": "2. Profile",
      "description": "The profile (with an E.164 phone number) is required before requesting an SMS code.",
      "item": [
        {
          "name": "Save profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"phone is stored in E.164\", function () {",
                  "    pm.expect(body.phone).to.match(/^\\+\\d{10,15}$/);",
                  "});",
                  "console.log(\"phoneVerified:\", body.phoneVerified);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lastName\": \"Test\",\n  \"firstName\": \"Postman\",\n  \"middleName\": null,\n  \"phone\": \"+375291234567\",\n  \"monthlyIncome\": \"1500.00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/me/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me",
                "profile"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 with profile or 204 when empty\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    console.log(\"phoneVerified:\", body.phoneVerified);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me",
                "profile"
              ]
            }
          },
          "response": []
        },
