# Скопируйте в .env.local при необходимости.

# true — фронт работает на моках без бэкенда (демо-данные в localStorage).
# По умолчанию (не задано или false) — настоящий API: /api проксируется Vite на localhost:8080, в Docker — nginx.
VITE_USE_MOCKS=false

# true — показать кнопки входа через Google/GitHub. Включать только вместе с профилем бэкенда oauth.
VITE_OAUTH_ENABLED=false
